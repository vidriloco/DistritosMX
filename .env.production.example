# Copy to .env.production on the server and fill in real values.
# .env.production is gitignored — never commit it.

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=distritos.mx,www.distritos.mx,.distritos.mx

# Leave unset in production. settings.py defaults it to false; docker-compose.prod.yaml
# pins it to false as well, and deploy-production.sh refuses to continue if the
# running process reports otherwise.
# DJANGO_DEBUG=false

# CSRF trusted origins are derived from DJANGO_ALLOWED_HOSTS (https:// each).
# Set this only when a form is posted from an origin that is not in that list.
# DJANGO_CSRF_TRUSTED_ORIGINS=https://distritos.mx,https://www.distritos.mx

# TLS. Turn the redirect on only once HTTPS actually works, or you get a loop.
# Set BEHIND_TLS_PROXY when nginx/caddy terminates TLS and forwards
# X-Forwarded-Proto, otherwise Django cannot tell the request was secure.
# DJANGO_SECURE_SSL_REDIRECT=true
# DJANGO_BEHIND_TLS_PROXY=true
# HSTS is hard to undo — browsers honour it for the full duration even after you
# stop sending it. Start small (e.g. 3600) and raise it once you are confident.
# DJANGO_HSTS_SECONDS=0

# Database
DB_NAME=wikiando_db
DB_USER=wikirootcito
DB_PASSWORD=change-me

# AWS (media storage on S3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=wikiando
AWS_S3_REGION_NAME=us-east-2

# App exposure. Keep 0.0.0.0 to serve directly on APP_PORT,
# or set APP_BIND=127.0.0.1 when running behind nginx/caddy.
APP_BIND=0.0.0.0
APP_PORT=8000
GUNICORN_WORKERS=3
